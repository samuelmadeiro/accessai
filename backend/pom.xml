<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.0</version>
    <relativePath/>
  </parent>

  <groupId>dev.accessai</groupId>
  <artifactId>backend</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>AccessAI Backend</name>

  <properties>
    <java.version>25</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!--
      Mesma armadilha do Flyway: spring-kafka e a biblioteca; a autoconfiguracao
      que le spring.kafka.* e cria KafkaTemplate e a fabrica de @KafkaListener
      vem deste modulo. Tambem nao ha starter.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-kafka</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.kafka</groupId>
      <artifactId>spring-kafka</artifactId>
    </dependency>

    <!--
      No Boot 4 as autoconfiguracoes foram modularizadas: flyway-core traz a
      biblioteca, mas quem executa a migracao na subida e este modulo. Sem ele
      o Flyway simplesmente nao roda e o Hibernate falha com
      "Schema validation: missing table". Nao existe starter equivalente.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <!-- Desde o Flyway 10 o suporte a cada banco e um modulo separado. -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>

    <!--
      Mesma armadilha do Flyway e do Kafka, terceira vez: no Boot 4 as
      autoconfiguracoes foram modularizadas. `spring-boot-starter-web` traz o
      RestClient como CLASSE, mas o bean `RestClient.Builder` vem deste modulo.
      Sem ele o contexto sobe ate encontrar o primeiro componente que injeta o
      builder e morre com "No qualifying bean of type RestClient$Builder".
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-restclient</artifactId>
    </dependency>

    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!--
      Anotacoes de nulidade. Vem transitiva pelo Spring Framework 7, mas o
      codigo usa @NonNull diretamente: dependencia direta se declara, senao
      uma troca de versao no Boot derruba a compilacao sem aviso.
      A versao vem do spring-boot-dependencies.
    -->
    <dependency>
      <groupId>org.jspecify</groupId>
      <artifactId>jspecify</artifactId>
    </dependency>

    <!-- ===================== teste ===================== -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>

    <!--
      Espera com condicao para os testes de resiliencia: o desfecho de um retry
      chega quando chega. Thread.sleep fixo passa aqui e falha no CI.
      A versao vem do spring-boot-dependencies.
    -->
    <dependency>
      <groupId>org.awaitility</groupId>
      <artifactId>awaitility</artifactId>
      <scope>test</scope>
    </dependency>

    <!--
      Testcontainers 2.x renomeou TODOS os modulos para o prefixo
      testcontainers-*. Em 1.x era org.testcontainers:postgresql; esse
      coordenada nao existe em 2.x.
    -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-kafka</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <!--
        A tabela WCAG e versionada em docs/wcag/, fora do modulo, porque ela
        nao pertence ao backend: e o contrato do projeto (CONTRIBUTING.md secao 6).
        Copiar em vez de duplicar mantem uma unica fonte de verdade.
      -->
      <resource>
        <directory>${project.basedir}/../docs/wcag</directory>
        <targetPath>wcag</targetPath>
        <includes>
          <include>criteria.json</include>
        </includes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
