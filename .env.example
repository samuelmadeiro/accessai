# Copie para .env e ajuste. O .env NAO vai para o git (ver .gitignore).
# CLAUDE.md secao 5: nenhuma credencial fica hardcoded, nem em teste,
# nem no docker-compose.yml.

# --- PostgreSQL ---
POSTGRES_DB=accessai
POSTGRES_USER=accessai
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_PORT=5432

# --- Kafka ---
# Porta publicada no host (listener PLAINTEXT do broker).
KAFKA_PORT=9092
# Backend rodando FORA do compose (./mvnw spring-boot:run): fala pelo host.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# Backend rodando DENTRO do compose: fala pela rede interna, listener INTERNO.
# Sao dois valores porque sao dois caminhos de rede diferentes; usar um so
# significa quebrar um dos dois modos de execucao.
KAFKA_BOOTSTRAP_SERVERS_INTERNO=kafka:29092

# --- Backend ---
BACKEND_PORT=8080
# Tamanho maximo do documento aceito no upload.
ACCESSAI_UPLOAD_TAMANHO_MAXIMO=25MB
