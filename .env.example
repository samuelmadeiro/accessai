# Copie para .env e ajuste. O .env NAO vai para o git (ver .gitignore).
# CONTRIBUTING.md secao 5: nenhuma credencial fica hardcoded, nem em teste,
# nem no docker-compose.yml.

# --- PostgreSQL ---
POSTGRES_DB=accessai
POSTGRES_USER=accessai
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_PORT=5432

# --- Kafka ---
# Porta publicada no host (listener PLAINTEXT do broker).
KAFKA_PORT=9092
# Backend rodando FORA do compose (./mvnw spring-boot:run): fala pelo host.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# Backend rodando DENTRO do compose: fala pela rede interna, listener INTERNO.
# Sao dois valores porque sao dois caminhos de rede diferentes; usar um so
# significa quebrar um dos dois modos de execucao.
KAFKA_BOOTSTRAP_SERVERS_INTERNO=kafka:29092

# --- ML Service ---
# Backend rodando FORA do compose: fala com o servico Python pelo host.
# Dentro do compose, o proprio compose injeta http://ml-service:8000.
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_PORT=8000
# Pasta do artefato do modelo, lida pelo servico de inferencia. Hoje esta
# vazia: sem modelo treinado, o servico responde pela heuristica e marca
# usouHeuristica=true em toda predicao.
ACCESSAI_MODELOS=models

# --- Backend ---
BACKEND_PORT=8080
# Tamanho maximo do documento aceito no upload.
ACCESSAI_UPLOAD_TAMANHO_MAXIMO=25MB

# Segredo do JWT (Slice 5A). HS256 exige pelo menos 32 bytes; a aplicacao recusa
# subir com menos. Gere o seu e NUNCA use este valor:
#   openssl rand -base64 48
ACCESSAI_JWT_SECRET=troque-este-valor-por-um-segredo-de-48-bytes-gerado-localmente

# Redis (Slice 5A): rate limit de upload por usuario.
REDIS_PORT=6379

# Teto mensal de gasto com LLM, em centavos (D5: US$ 10). O contador vive no
# Redis. Hoje o provider e uma fixture e nunca gasta nada.
ACCESSAI_IA_TETO_CENTAVOS=1000
